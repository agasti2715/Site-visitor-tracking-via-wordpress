# Port the dashboard listens on (Render sets its own)
PORT=4000

# Protects the dashboard and its API with a browser login (any username, this password).
# Leave empty only on your own machine. ALWAYS set it on a hosted dashboard.
DASHBOARD_PASSWORD=

# Hosted database (turso.tech). Leave both empty to use the local file below instead.
# Get them with: Turso dashboard → your database → "Connect" (URL) and "Create token".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local database file, used when TURSO_DATABASE_URL is empty
DB_PATH=./data/tracker.db

# Set to true when running behind a reverse proxy (Render, nginx, Caddy, etc.)
# so the visitor's real IP is read from X-Forwarded-For.
TRUST_PROXY=false

# Optional ip-api.com Pro key. Without it the free endpoint is used
# (45 lookups/minute, non-commercial use only). Results are cached per IP.
IPAPI_KEY=

# Local testing only: visits from 127.0.0.1 are looked up as this machine's
# public IP, so you can see real location/company data while testing.
# Keep false in production.
RESOLVE_LOCALHOST_AS_SELF=true
