# Port the tracker and dashboard listen on
PORT=4000

# Public address of this tracker once deployed, e.g. https://track.yourdomain.com
# Baked into the WordPress plugin download. Empty = the address you opened the dashboard on.
PUBLIC_URL=

# Protects the dashboard and its API with HTTP Basic auth (user: admin).
# Leave empty only on your own machine. ALWAYS set it before deploying.
DASHBOARD_PASSWORD=

# Set to true when running behind a reverse proxy (nginx, Caddy, Render, etc.)
# so the visitor's real IP is read from X-Forwarded-For.
TRUST_PROXY=false

# Where the SQLite database lives
DB_PATH=./data/tracker.db

# Optional ip-api.com Pro key. Without it the free endpoint is used
# (45 lookups/minute, non-commercial use only). Results are cached per IP.
IPAPI_KEY=

# Local testing only: visits from 127.0.0.1 are looked up as this machine's
# public IP, so you can see real location/company data while testing.
# Keep false in production.
RESOLVE_LOCALHOST_AS_SELF=true
